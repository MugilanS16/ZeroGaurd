# ZeroGuard AI Configuration
SECRET_KEY=dev-secret-key-zeroguard-ai-2026-super-secure-change-in-prod
DATABASE_URI=sqlite:///zeroguard.db
GEMINI_API_KEY=AIzaSyDqKN4z4unW4dpQvzx8Axz1GhkrHLte8q0
FLASK_ENV=development
FLASK_DEBUG=1

# -----------------------------------------------------------------
# OTP & 2-Step Verification Security Engine
# -----------------------------------------------------------------
OTP_SECRET_KEY=dev-otp-hmac-sha256-server-secret-key-change-in-production
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_HOURLY_SENDS=5
OTP_EMAIL_FALLBACK=false

# -----------------------------------------------------------------
# Messaging Provider Selection
# Options: 'email' (Recommended: Free Gmail SMTP), 'fast2sms', 'twilio', 'console'
# -----------------------------------------------------------------
MESSAGING_PROVIDER=email

# -----------------------------------------------------------------
# Gmail SMTP Email Configuration (Free 2FA Delivery)
# -----------------------------------------------------------------
# Set MAIL_SUPPRESS_SEND=False to enable real email transmission.
# MAIL_PASSWORD must be a 16-character Google App Password (not your Gmail login password).
# How to get an App Password:
# 1. Enable 2-Step Verification in Google Account -> Security.
# 2. Go to https://myaccount.google.com/apppasswords and generate an App Password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=abcd1234efgh5678
MAIL_DEFAULT_SENDER=your-email@gmail.com
MAIL_SUPPRESS_SEND=False

# -----------------------------------------------------------------
# Fast2SMS Credentials (Direct SMS to any Indian Mobile Number)
# -----------------------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio Credentials (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_SMS_FROM=+1234567890
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# MSG91 Credentials (SMS + WhatsApp for India Telecom)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=ZEROGD
MSG91_WHATSAPP_NUMBER=+919876543210
MSG91_INTEGRATED_NUMBER=919876543210

# India Telecom DLT Settings
DLT_ENTITY_ID=1101452367890123456
DLT_SENDER_ID=ZEROGD
DLT_TEMPLATE_ID_OTP=1107161829304152637
DLT_TEMPLATE_ID_GUARDIAN=1107161829304152638

# WhatsApp Meta HSM Approved Template Identifiers
