# ZeroGuard AI Configuration
SECRET_KEY=dev-secret-key-zeroguard-ai-2026-super-secure-change-in-prod
DATABASE_URI=sqlite:///zeroguard.db
GEMINI_API_KEY=
FLASK_ENV=development
FLASK_DEBUG=1

# Real Email SMTP Configuration (Gmail SMTP)
# IMPORTANT: Gmail requires 2-Step Verification enabled and a 16-character "App Password"
# (Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-real-gmail@gmail.com
MAIL_PASSWORD=your-16-char-gmail-app-password
MAIL_DEFAULT_SENDER=your-real-gmail@gmail.com
MAIL_SUPPRESS_SEND=False
